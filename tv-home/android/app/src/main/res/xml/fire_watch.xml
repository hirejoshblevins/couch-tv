<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes only: no content reading, no feedback. The code also switches on key filtering at run
     time: this fork counts Home presses on every TV (five quick ones stand couch-tv aside, Failsafe.kt),
     and on a Xiaomi TV the Home and Mi keys are handled (FireWatch.onKeyEvent). No other key is looked at. -->
<!-- canRetrieveWindowContent is declared only so the TV delivers the events: some builds (a TCL
     Smart TV Pro on Android 12) hand window-change events only to services with this capability.
     The code reads nothing but the event's package and class names, never the screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/fire_watch_desc" />
