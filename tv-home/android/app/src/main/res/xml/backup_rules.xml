<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The smart home settings hold a Home Assistant token: never in a backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="ha.xml" />
    <!-- the Google Home settings hold Google tokens and a private album link: never in a backup either -->
    <exclude domain="sharedpref" path="gh.xml" />
</full-backup-content>
